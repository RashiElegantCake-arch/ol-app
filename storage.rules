rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Notes and Past Paper PDFs are publicly readable by all students
    match /notes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /papers/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /marking_schemes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
