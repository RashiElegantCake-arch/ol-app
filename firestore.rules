rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Subjects collection: readable by all students, writable only by admins
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Notes collection: readable by all students, writable only by admins
    match /notes/{noteId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Papers collection: readable by all students, writable only by admins
    match /papers/{paperId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Quotes collection: readable by all students
    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // User bookmarks and study progress: private per authenticated student
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
